<main class="order-details-page">
	{{#if msg}}
		<div id="msg" class="alert alert-success alert-dismissible fade show order-alert" role="alert">
			<i class="bi bi-check-circle-fill"></i>
			<span>{{msg}}</span>
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
		</div>
	{{/if}}
	{{#if error}}
		<div id="errordiv" class="alert alert-danger alert-dismissible fade show order-alert" role="alert">
			<i class="bi bi-exclamation-circle-fill"></i>
			<span>{{error}}</span>
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
		</div>
	{{/if}}

	<button id="back" type="button" onclick="voltar()" title="Voltar para pedidos" aria-label="Voltar para pedidos">
		<i class="fas fa-arrow-left"></i>
	</button>

	<section id="container">
		<div id="pedido-container">
			<header class="header-pedido">
				<div class="order-heading">
					<span class="order-eyebrow"><i class="fas fa-file-invoice"></i> Detalhes do pedido</span>
					<h1 class="title">Pedido #{{dados.pedido_id}}</h1>
					<p class="cliente-name"><span>Cliente</span><strong>{{dados.nome}}</strong></p>
				</div>
				<div class="delivery-status">
					<span class="status-label">Prazo de entrega</span>
					{{#if dados.dias_faltantes}}
						<span class="badge delivery-badge delivery-on-time"><i class="fas fa-clock"></i> {{dados.dias_faltantes}} dias restantes</span>
					{{else}}
						<span class="badge delivery-badge delivery-late"><i class="fas fa-exclamation-triangle"></i> Entrega atrasada</span>
					{{/if}}
				</div>
			</header>

			<section id="pedido-info" aria-label="Resumo do pedido">
				<div class="info-card">
					<span class="info-label">Status</span>
					{{#if dados.pedido_status}}
						<span class="badge order-status">{{dados.pedido_status}}</span>
					{{else}}
						<span class="badge order-status order-status-empty">Sem status</span>
					{{/if}}
				</div>
				<div class="info-card">
					<span class="info-label">Entrega prevista</span>
					<strong>{{data_brasileira dados.pedido_data}}</strong>
				</div>
				<div class="info-card total-card">
					<span class="info-label">Total do pedido</span>
					<strong>R$ {{dados.total_pedido}}</strong>
				</div>
			</section>

			<section id="metricas-container" aria-label="Métricas do pedido">
				<div class="metrica-card"><span class="metric-icon"><i class="fas fa-boxes"></i></span><strong>{{dados.total_itens}}</strong><span>Total de itens</span></div>
				<div class="metrica-card"><span class="metric-icon metric-positive"><i class="fas fa-ruler-combined"></i></span><strong>{{dados.total_itens_com_medida}}</strong><span>Itens com medida</span></div>
				<div class="metrica-card"><span class="metric-icon metric-warning"><i class="fas fa-ruler"></i></span><strong>{{dados.total_itens_sem_medida}}</strong><span>Itens sem medida</span></div>
				<div class="metrica-card"><span class="metric-icon metric-time"><i class="fas fa-hourglass-half"></i></span><strong>{{dados.dias_faltantes}}</strong><span>Dias restantes</span></div>
			</section>

			<section id="itens-container" aria-labelledby="items-title">
				<div class="section-header">
					<div><span class="section-kicker">Composição do pedido</span><h2 id="items-title">Itens do pedido</h2></div>
					<span class="items-count">{{dados.total_itens}} item(ns)</span>
				</div>
				{{#each dados.itens}}
					<article class="item-card">
						<div class="item-top">
							<div class="item-main-content">
								<div class="item-title-row"><span class="item-index">Item {{@index}}</span><h3>{{produto}}</h3></div>
								<div class="item-details">
									<p><span>Cor</span><strong>{{#if cor}}{{cor}}{{else}}Não informado{{/if}}</strong></p>
									<p><span>Tecido</span><strong>{{#if tecido}}{{tecido}}{{else}}Não informado{{/if}}</strong></p>
									<p><span>Preço unitário</span><strong>R$ {{preco_unitario}}</strong></p>
								</div>
							</div>
							<div class="item-actions-column">
								<span class="badge quantity-badge"><i class="fas fa-layer-group"></i> {{quantidade}} un.</span>
								<button class="btn item-detail-button" type="button" onclick="detalhes_item({{id}})"><i class="fas fa-arrow-right"></i> Detalhes</button>
							</div>
						</div>
					</article>
				{{/each}}
			</section>

			<footer id="acoes-container">
				<button class="btn btn-primary" type="button"><i class="fas fa-ruler-combined"></i> Ver medidas</button>
				<button class="btn btn-outline-secondary" type="button"><i class="fas fa-pen"></i> Editar pedido</button>
			</footer>
		</div>
	</section>
</main>
