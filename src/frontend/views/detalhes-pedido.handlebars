<button id="back" onclick="voltar()">
    <i class="fas fa-home"></i>
</button>

{{#if msg}}
<div id="msg" class="d-flex gap-3 alert alert-success alert-dismissible fade show position-fixed top-0 end-0 me-5 m-3">
    <i class="bi bi-check-square-fill text-success"></i>
    <p class="fw-bold mb-0">{{msg}}</p>
</div>
{{/if}}

{{#if error}}
<div id="errordiv" class="d-flex gap-3 alert alert-danger alert-dismissible fade show position-fixed top-0 end-0 me-5 m-3">
    <i class="bi bi-x-square-fill text-danger"></i>
    <p class="fw-bold mb-0">{{error}}</p>
</div>
{{/if}}

<div id="container">

    <div id="pedido-container">

        <div class="header-pedido">

            <div>
                <h1 class="title">
                    Pedido #{{dados.pedido_id}}
                </h1>

                <p class="cliente-name">
                    Cliente: <strong>{{dados.nome}}</strong>
                </p>
            </div>

            <div>

                {{#if dados.dias_faltantes}}

                    <span class="badge bg-success fs-6">
                        {{dados.dias_faltantes}} dias restantes
                    </span>

                {{else}}

                    <span class="badge bg-danger fs-6">
                        Entrega atrasada
                    </span>

                {{/if}}

            </div>

        </div>

        <div id="pedido-info">

            <div class="info-card">

                <h3>Status</h3>

                {{#if dados.pedido_status}}

                    <span class="badge bg-primary">
                        {{dados.pedido_status}}
                    </span>

                {{else}}

                    <span class="badge bg-secondary">
                        sem status
                    </span>

                {{/if}}

            </div>

            <div class="info-card">

                <h3>Entrega</h3>

                <p>{{data_brasileira dados.pedido_data}}</p>

            </div>

            <div class="info-card">

                <h3>Total</h3>

                <p>R$ {{dados.total_pedido}}</p>

            </div>

        </div>

        <div id="metricas-container">

            <div class="metrica-card">

                <h2>{{dados.total_itens}}</h2>

                <p>Total de itens</p>

            </div>

            <div class="metrica-card">

                <h2>{{dados.total_itens_com_medida }}</h2>

                <p>Itens com medida</p>

            </div>

            <div class="metrica-card">

                <h2>{{dados.total_itens_sem_medida}}</h2>

                <p>Itens sem medida</p>

            </div>

            <div class="metrica-card">

                <h2>{{dados.dias_faltantes}}</h2>

                <p>Dias restantes</p>

            </div>

        </div>

        <div id="itens-container">

            <div class="section-header">
                <h2>Itens do Pedido</h2>
            </div>

            {{#each dados.itens}}

            <div class="item-card">

                <div class="item-top">

                    <h3>{{produto}}</h3>

                    <span class="badge bg-dark">
                        Qtd: {{quantidade}}
                    </span>

                </div>

                <div class="item-body">

                    <p>
                        <strong>Cor:</strong>

                        {{#if cor}}
                            {{cor}}
                        {{else}}
                            Não informado
                        {{/if}}
                    </p>

                    <p>
                        <strong>Tecido:</strong>

                        {{#if tecido}}
                            {{tecido}}
                        {{else}}
                            Não informado
                        {{/if}}
                    </p>

                    <p>
                        <strong>Preço Unitário:</strong>
                        R$ {{preco_unitario}}
                    </p>

                </div>

            </div>

            {{/each}}

        </div>

        <div id="acoes-container">

            <button class="btn btn-primary">
                Ver Medidas
            </button>

            <button class="btn btn-outline-secondary">
                Editar Pedido
            </button>

        </div>

    </div>

</div>