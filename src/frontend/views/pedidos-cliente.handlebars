<a onclick="voltar({{dados.pedidos.0.cliente_id}})"><button id="back"><i class="fas fa-home"></i></button></a>

<div id="fundo">
    <div class="page-header">
        <div>
            <h1 id="title">Pedidos</h1>
            <p class="page-subtitle">Gerencie os pedidos registrados para o cliente.</p>
        </div>

        <div id="opcoes">
            <select id="fieldsearch" class="form-select">
                <option value="id">ID do Pedido</option>
                <option value="cliente">Cliente</option>
                <option value="data">Data</option>
                <option value="status">Status</option>
            </select>
            <input id="inputsearch" type="search" placeholder="Digite o termo da busca...">
            <button id="btnsearch"><i class="fas fa-search"></i></button>
            <button id="newpedido"><i class="fas fa-cart-plus"></i></button>
        </div>
    </div>

    <hr>

    {{#if dados.pedidos.length}}
        <h2 class="section-title">Pedidos Registrados</h2>
        <div class="card-container">

            {{#each dados.pedidos}}
            <div class="card">

                <div class="topo-card">
                    <h3>Pedido #{{id}}</h3>
                    <span class="status {{status}}">
                        {{status}}
                    </span>
                </div>

                <p><strong>Cliente:</strong>
                    {{nome}}
                </p>

                <p><strong>Data:</strong> {{data}}</p>

                <hr>

                <p><strong>Itens:</strong></p>

                <ul class="lista-itens">
                    {{#each itens}}
                    <li>
                        {{quantidade}}x {{produto}}
                        <small>({{modelo_produto}})</small>
                    </li>
                    {{/each}}
                </ul>

                <hr>

                <p class="total">
                    Total: <span>R$ {{total}}</span>
                </p>
                <div class="card-actions">
                    <button id="deletar" class="btn btn-danger" onclick="deletarPedido({{id}})">Excluir</button>
                    <button id="editar" class="btn btn-outline-primary" onclick="editarPedido({{id}})">Editar</button>
                    <button class="btn-details btn btn-primary" onclick="detalhesPedido({{id}})">Detalhes</button>
                </div>
            </div>
            {{/each}}

        </div>
    {{else}}
        <h2 class="section-title">Você ainda não registrou nenhum pedido!</h2>
    {{/if}}

    <div id="modalConfirm">
        <div class="modal-box">
            <h2 id="modalMensagem">Tem certeza que deseja excluir este pedido?</h2>
            <p class="modal-text">Esta ação não poderá ser desfeita.</p>
            <div class="modal-actions">
                <button id="btnConfirmar" onclick="confirmarExclusao()">Sim</button>
                <button id="btnCancelar" onclick="fecharModal()">Cancelar</button>
            </div>
        </div>
    </div>

    <div id="modalAviso">
        <div class="modal-box">
            <h2 id="avisoMensagem">Ocorreu um erro inesperado.</h2>
            <div class="modal-actions">
                <button id="btnOK" onclick="fecharAviso()">Ok</button>
            </div>
        </div>
    </div>
</div>