<button id="back" type="button" onclick="voltar()" title="Voltar">
    <i class="fas fa-arrow-left"></i>
</button>

{{#if msg}}
<div id="msg" class="d-flex gap-3 alert alert-success alert-dismissible fade show">
    <i class="bi bi-check-square-fill text-success"></i>
    <p class="fw-bold mb-0">{{msg}}</p>
</div>
{{/if}}

{{#if error}}
<div id="errordiv" class="d-flex gap-3 alert alert-danger alert-dismissible fade show">
    <i class="bi bi-x-square-fill text-danger"></i>
    <p class="fw-bold mb-0">{{error}}</p>
</div>
{{/if}}

<div class="page-layout">
    <div id="container-detalhes">
        
        <!-- Cabeçalho Principal -->
        <header class="detalhes-header">
            <div class="header-icon">
                {{#if (eq cliente.tipo_cliente "empresa")}}
                    <i class="fas fa-building"></i>
                {{else}}
                    <i class="fas fa-user-circle"></i>
                {{/if}}
            </div>
            <div>
                <h1 class="title">Detalhes do Cliente</h1>
                <span class="subtitle-page">Gerenciamento de informações, {{#if (eq cliente.tipo_cliente "empresa")}}funcionários{{else}}medidas{{/if}} e pedidos</span>
            </div>
        </header>

        <!-- Grid Principal -->
        <div id="cliente-detalhes">
            
            <!-- CARD DA ESQUERDA: DADOS DO CLIENTE -->
            <div id="info-clientes">
                <div class="info-header">
                    <h2>{{cliente.nome}}</h2>
                    <span class="badge-tipo">
                        {{#if (eq cliente.tipo_cliente "empresa")}}
                            <i class="fas fa-building me-1"></i> Pessoa Jurídica
                        {{else}}
                            <i class="fas fa-user me-1"></i> Pessoa Física
                        {{/if}}
                    </span>
                </div>

                <div class="info-body">
                    <div class="campo-info">
                        <span class="label-info"><i class="fas fa-hashtag"></i> Código de Identificação</span>
                        <span class="value-info">#{{cliente.id}}</span>
                    </div>

                    {{#if (eq cliente.tipo_cliente "empresa")}}
                        <!-- Dados Específicos para Empresa -->
                        <div class="campo-info">
                            <span class="label-info"><i class="fas fa-briefcase"></i> Nome Fantasia / Empresa</span>
                            <span class="value-info">
                                {{#if cliente.nome_empresa}}
                                    {{cliente.nome_empresa}}
                                {{else}}
                                    <span class="text-muted fw-normal">Não informado</span>
                                {{/if}}
                            </span>
                        </div>

                        <div class="campo-info">
                            <span class="label-info"><i class="far fa-id-card"></i> CPF / Documento</span>
                            <span class="value-info">
                                {{#if cliente.cpf}}
                                    {{cliente.cpf}}
                                {{else}}
                                    <span class="text-muted fw-normal">Nenhum CPF cadastrado</span>
                                {{/if}}
                            </span>
                        </div>
                    {{else}}
                        <!-- Dados Específicos para Pessoa Física -->
                        <div class="campo-info">
                            <span class="label-info"><i class="far fa-id-card"></i> CPF</span>
                            <span class="value-info">
                                {{#if cliente.cpf}}
                                    {{cliente.cpf}}
                                {{else}}
                                    <span class="text-muted fw-normal">Nenhum CPF cadastrado</span>
                                {{/if}}
                            </span>
                        </div>
                    {{/if}}

                    <div class="campo-info">
                        <span class="label-info"><i class="fas fa-phone-alt"></i> Telefone de Contato</span>
                        <span class="value-info">
                            {{#if cliente.telefone}}
                                {{cliente.telefone}}
                            {{else}}
                                <span class="text-muted fw-normal">Não informado</span>
                            {{/if}}
                        </span>
                    </div>
                </div>
            </div>

            <!-- CARD DA DIREITA: AÇÕES (MEDIDAS/FUNCIONÁRIOS E PEDIDOS) -->
            <div class="card-stack">
                
                <!-- Bloco de Medidas OU Funcionários -->
                <div id="card-modulo-acao">
                    {{#if (eq cliente.tipo_cliente "empresa")}}
                        <div class="modulo-icon">
                            <i class="fas fa-users"></i>
                        </div>
                        <div class="modulo-text">
                            <h3>Funcionários</h3>
                            <p>Gestão e consulta de colaboradores da empresa.</p>
                        </div>
                        <button class="btn btn-primary" onclick="listarFuncionarios({{cliente.id}})">
                            <i class="fas fa-users-cog me-2"></i> Consultar
                        </button>
                    {{else}}
                        <div class="modulo-icon">
                            <i class="fas fa-ruler-combined"></i>
                        </div>
                        <div class="modulo-text">
                            <h3>Medidas</h3>
                            <p>Consulte as medidas corporais e padrões.</p>
                        </div>
                        <button class="btn btn-primary" onclick="listarMedidas({{cliente.id}})">
                            <i class="fas fa-ruler me-2"></i> Consultar
                        </button>
                    {{/if}}
                </div>

                <!-- Bloco de Pedidos -->
                <div id="pedido-detalhes">
                    <div class="pedido-header">
                        <div class="modulo-icon-secundario">
                            <i class="fas fa-shopping-bag"></i>
                        </div>
                        <div>
                            <h3>Pedidos do Cliente</h3>
                            <span class="pedido-count">
                                {{#if cliente.quantidade_pedidos}}
                                    <strong>{{cliente.quantidade_pedidos}}</strong> pedido(s) registrado(s)
                                {{else}}
                                    Nenhum pedido ativo
                                {{/if}}
                            </span>
                        </div>
                    </div>
                    <button class="btn btn-outline-primary" onclick="pedidosCliente({{cliente.id}})">
                        <i class="fas fa-list-alt me-2"></i> Ver Pedidos
                    </button>
                </div>

            </div>
        </div>
    </div>
</div>