<a
  id="back"
  href="/pedidos/detalhes/{{pedido_id}}"
  title="Voltar para o pedido"
  aria-label="Voltar para o pedido"
>
  <i class="fas fa-arrow-left"></i>
</a>

{{#if msg}}
  <div
    id="msg"
    class="alert alert-success alert-dismissible fade show"
    role="alert"
  >
    <i class="bi bi-check-square-fill"></i><span>{{msg}}</span>
    <button
      type="button"
      class="btn-close"
      data-bs-dismiss="alert"
      aria-label="Fechar"
    ></button>
  </div>
{{/if}}

{{#if error}}
  <div
    id="errordiv"
    class="alert alert-danger alert-dismissible fade show"
    role="alert"
  >
    <i class="bi bi-x-square-fill"></i><span>{{error}}</span>
    <button
      type="button"
      class="btn-close"
      data-bs-dismiss="alert"
      aria-label="Fechar"
    ></button>
  </div>
{{/if}}

<main class="item-details-page">
  <header class="item-details-header">
    <div>
      <span class="eyebrow"><i class="fas fa-box-open"></i>
        Pedido #{{pedido_id}}
        / Item #{{item.id}}</span>
      <h1>Detalhes do item</h1>
      <p>{{item.produto}}
        <span aria-hidden="true">/</span>
        {{item.cor}}
        <span aria-hidden="true">/</span>
        {{nome}}</p>
    </div>
    <div class="total-summary">
      <span>Com medidas</span>
      <strong>{{quantidade_com_medidas}}</strong>
      <small>de {{item.quantidade}} peças</small>
    </div>
  </header>

  <section class="item-overview" aria-label="Resumo do item">
    <div class="overview-heading">
      <span class="section-kicker">Produto</span>
      <h2>Informações do item</h2>
    </div>
    <div class="detail-grid">
      <div class="detail-item detail-item-featured"><span>Produto</span><strong
        >{{item.produto}}</strong></div>
      <div class="detail-item"><span>Modelo</span><strong
        >{{item.modelo_produto}}</strong></div>
      <div class="detail-item"><span>Cor</span><strong
        >{{item.cor}}</strong></div>
      <div class="detail-item"><span>Tecido</span><strong
        >{{item.tecido}}</strong></div>
      <div class="detail-item"><span>Tamanho</span><strong
        >{{item.tamanho}}</strong></div>
      <div class="detail-item"><span>Quantidade</span><strong
        >{{item.quantidade}}</strong></div>
      <div class="detail-item"><span>Preço total</span><strong>R$
          {{item.preco}}</strong></div>
      <div class="detail-item"><span>Preço unitário</span><strong>R$
          {{item.preco_unitario}}</strong></div>
      <div class="detail-item detail-item-wide"><span>Detalhes</span><strong
        >{{item.detalhes}}</strong></div>
      <div class="detail-item detail-item-wide"><span>Complemento</span><strong
        >{{item.complemento}}</strong></div>
    </div>
  </section>

  <section class="measurements-section" aria-label="Medidas do item">
    <div class="section-heading">
      <div><span class="section-kicker">Organização</span><h2>Medidas
          cadastradas</h2></div>
      <span class="section-total"><strong>{{quantidade_com_medidas}}</strong>
        peças distribuídas</span>
    </div>

    <div class="measurement-grid">
      <article class="measurement-card standard-card">
        <div class="measurement-icon"><i
            class="fas fa-ruler-combined"
          ></i></div>
        <div class="measurement-copy"><span
            class="measurement-label"
          >Grade</span><h3>Medidas padrão</h3><p>Tamanhos e ajustes padronizados
            para este item.</p></div>
        <strong class="measurement-count">{{quantidade_medidas_padrao}}<small
          >un.</small></strong>
        <a
          class="measurement-link"
          href="/medidas/itens-pedidos/{{item.id}}/padrao"
        >Ver medidas padrão <i class="fas fa-arrow-right"></i></a>
      </article>

      <article class="measurement-card female-card">
        <div class="measurement-icon"><i class="fas fa-venus"></i></div>
        <div class="measurement-copy"><span class="measurement-label">Sob medida</span><h3
          >Feminino</h3><p>Medidas personalizadas para modelagem feminina.</p></div>
        <strong class="measurement-count">{{quantidade_feminina}}<small
          >un.</small></strong>
        <a
          class="measurement-link"
          href="/medidas/itens-pedidos/{{item.id}}/SobMedida/feminina"
        >Ver medidas femininas <i class="fas fa-arrow-right"></i></a>
      </article>

      <article class="measurement-card male-card">
        <div class="measurement-icon"><i class="fas fa-mars"></i></div>
        <div class="measurement-copy"><span class="measurement-label">Sob medida</span><h3
          >Masculino</h3><p>Medidas personalizadas para modelagem masculina.</p></div>
        <strong class="measurement-count">{{quantidade_masculina}}<small
          >un.</small></strong>
        <a
          class="measurement-link"
          href="/medidas/itens-pedidos/{{item.id}}/SobMedida/masculina"
        >Ver medidas masculinas <i class="fas fa-arrow-right"></i></a>
      </article>
    </div>
  </section>
</main>