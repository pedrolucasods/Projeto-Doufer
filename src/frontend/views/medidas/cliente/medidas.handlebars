<div class="page-layout">
    <!-- Alertas -->
    {{#if msg}}
    <div id="msg" class="d-flex gap-3 alert alert-success alert-dismissible fade show position-fixed top-0 end-0 me-5 m-3">
        <i class="bi bi-check-square-fill text-success"></i>
        <p class="fw-bold mb-0">{{msg}}</p>
    </div>
    {{/if}}

    {{#if error}}
    <div id="errordiv" class="d-flex gap-3 alert alert-danger alert-dismissible fade show position-fixed top-0 end-0 me-5 m-3">
        <i class="bi bi-x-square-fill text-danger"></i>
        <p class="fw-bold mb-0">{{error}}</p>
    </div>
    {{/if}}

    <!-- Cabeçalho -->
    <header class="page-header">
        <button id="back" type="button" onclick="voltar({{id}})" title="Voltar">
            <i class="fas fa-arrow-left"></i>
        </button>

        <div class="header-user-info">
            <div class="user-avatar">
                <i class="fas fa-user"></i>
            </div>
            <div>
                <h1 id="title-cliente">Medidas de {{nome}}</h1>
                <span class="subtitle-page">Visualização das medidas cadastradas para o colaborador/cliente</span>
            </div>
        </div>
    </header>

    <!-- Cards Container -->
    <div id="container-medidas">

        <!-- CARD 1: SOB MEDIDA (FEMININA OU MASCULINA) -->
        <section class="card-medida">
            <div class="card-header-medida d-flex justify-content-between align-items-center">
                <h2>
                    <i class="fas fa-ruler-horizontal"></i>
                    Sob Medida
                </h2>
                
                <div class="d-flex align-items-center gap-2">
                    <!-- Dropdown Select para alternar/escolher o tipo de medida -->
                    {{#if medida_sob_medida_feminina.0.id}}
                        <select id="selectTipoSobMedida" class="form-select form-select-sm" onchange="alternarTipoSobMedida(this.value)">
                            <option value="feminina" selected>Feminina</option>
                            <option value="masculina">Masculina</option>
                        </select>
                    {{else if medida_sob_medida_masculina.0.id}}
                        <select id="selectTipoSobMedida" class="form-select form-select-sm" onchange="alternarTipoSobMedida(this.value)">
                            <option value="feminina">Feminina</option>
                            <option value="masculina" selected>Masculina</option>
                        </select>
                    {{else}}
                        <select id="selectTipoSobMedida" class="form-select form-select-sm" onchange="alternarTipoSobMedida(this.value)">
                            <option value="feminina" selected>Feminina</option>
                            <option value="masculina">Masculina</option>
                        </select>
                    {{/if}}

                    <span class="header-tag" id="tagTipoSobMedida">
                        {{#if medida_sob_medida_feminina.0.id}}
                            Feminina
                        {{else if medida_sob_medida_masculina.0.id}}
                            Masculina
                        {{else}}
                            Personalizada
                        {{/if}}
                    </span>
                </div>
            </div>

            <div class="card-body-medida">
                <div id="sob-medida-feminina" style="{{#if medida_sob_medida_feminina.0.id}}display:block;{{else if medida_sob_medida_masculina.0.id}}display:none;{{else}}display:block;{{/if}}">
                    {{#if medida_sob_medida_feminina.0.id}}
                        <div class="bloco-medidas">
                            <h3 class="bloco-title">
                                <i class="fas fa-female"></i> Medidas do corpo (Feminino)
                            </h3>

                            <div class="grid-medidas-corpo">
                                <div class="coluna-medidas">
                                    <div class="campo-medida">
                                        <span class="campo-label"><i class="fas fa-vest"></i> Busto</span>
                                        <span class="campo-value">{{mostrar medida_sob_medida_feminina.0.busto}}</span>
                                    </div>
                                    <div class="campo-medida">
                                        <span class="campo-label"><i class="fas fa-hourglass-half"></i> Cintura</span>
                                        <span class="campo-value">{{mostrar medida_sob_medida_feminina.0.cintura}}</span>
                                    </div>
                                    <div class="campo-medida">
                                        <span class="campo-label"><i class="fas fa-box"></i> Quadril</span>
                                        <span class="campo-value">{{mostrar medida_sob_medida_feminina.0.quadril}}</span>
                                    </div>
                                    <div class="campo-medida">
                                        <span class="campo-label"><i class="fas fa-arrows-alt-v"></i> Comprimento</span>
                                        <span class="campo-value">{{mostrar medida_sob_medida_feminina.0.comprimento}}</span>
                                    </div>
                                </div>

                                <div class="coluna-medidas">
                                    <div class="campo-medida">
                                        <span class="campo-label"><i class="fas fa-tshirt"></i> Ombro</span>
                                        <span class="campo-value">{{mostrar medida_sob_medida_feminina.0.ombro}}</span>
                                    </div>
                                    <div class="campo-medida">
                                        <span class="campo-label"><i class="fas fa-user-friends"></i> Costas</span>
                                        <span class="campo-value">{{mostrar medida_sob_medida_feminina.0.costas}}</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="bloco-medidas mt-4">
                            <h3 class="bloco-title">
                                <i class="fas fa-ruler"></i> Medidas da manga
                            </h3>
                            <div class="campo-medida">
                                <span class="campo-label"><i class="fas fa-arrows-alt-v"></i> Comprimento da manga</span>
                                <span class="campo-value">{{mostrar medida_sob_medida_feminina.0.comprimento_da_manga}}</span>
                            </div>
                            <div class="campo-medida">
                                <span class="campo-label"><i class="fas fa-arrows-alt-h"></i> Largura da manga</span>
                                <span class="campo-value">{{mostrar medida_sob_medida_feminina.0.largura_da_manga}}</span>
                            </div>
                        </div>
                    {{else}}
                        <div class="empty-state-card">
                            <i class="fas fa-ruler-combined text-muted mb-2" style="font-size: 2rem;"></i>
                            <p class="text-muted mb-0">Nenhuma medida sob medida feminina cadastrada.</p>
                        </div>
                    {{/if}}
                </div>

                <div id="sob-medida-masculina" style="{{#if medida_sob_medida_feminina.0.id}}display:none;{{else if medida_sob_medida_masculina.0.id}}display:block;{{else}}display:none;{{/if}}">
                    {{#if medida_sob_medida_masculina.0.id}}
                        <div class="bloco-medidas">
                            <h3 class="bloco-title">
                                <i class="fas fa-male"></i> Medidas do corpo (Masculino)
                            </h3>

                            <div class="grid-medidas-corpo">
                                <div class="coluna-medidas">
                                    <div class="campo-medida">
                                        <span class="campo-label"><i class="fas fa-tshirt"></i> Ombro</span>
                                        <span class="campo-value">{{mostrar medida_sob_medida_masculina.0.ombro}}</span>
                                    </div>
                                    <div class="campo-medida">
                                        <span class="campo-label"><i class="fas fa-arrows-alt-h"></i> Circunferência Tórax</span>
                                        <span class="campo-value">{{mostrar medida_sob_medida_masculina.0.circunferencia_torax}}</span>
                                    </div>
                                    <div class="campo-medida">
                                        <span class="campo-label"><i class="fas fa-circle-notch"></i> Circunferência Abdômen</span>
                                        <span class="campo-value">{{mostrar medida_sob_medida_masculina.0.circunferencia_abdomen}}</span>
                                    </div>
                                </div>

                                <div class="coluna-medidas">
                                    <div class="campo-medida">
                                        <span class="campo-label"><i class="fas fa-user-friends"></i> Costa</span>
                                        <span class="campo-value">{{mostrar medida_sob_medida_masculina.0.costa}}</span>
                                    </div>
                                    <div class="campo-medida">
                                        <span class="campo-label"><i class="fas fa-hand-paper"></i> Largura Punho</span>
                                        <span class="campo-value">{{mostrar medida_sob_medida_masculina.0.largura_punho}}</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="bloco-medidas mt-4">
                            <h3 class="bloco-title">
                                <i class="fas fa-ruler"></i> Medidas da manga
                            </h3>
                            <div class="campo-medida">
                                <span class="campo-label"><i class="fas fa-arrows-alt-v"></i> Comprimento da manga</span>
                                <span class="campo-value">{{mostrar medida_sob_medida_masculina.0.comprimento_manga}}</span>
                            </div>
                            <div class="campo-medida">
                                <span class="campo-label"><i class="fas fa-arrows-alt-h"></i> Largura da manga</span>
                                <span class="campo-value">{{mostrar medida_sob_medida_masculina.0.largura_manga}}</span>
                            </div>
                        </div>
                    {{else}}
                        <div class="empty-state-card">
                            <i class="fas fa-ruler-combined text-muted mb-2" style="font-size: 2rem;"></i>
                            <p class="text-muted mb-0">Nenhuma medida sob medida masculina cadastrada.</p>
                        </div>
                    {{/if}}
                </div>
            </div>

            <!-- Rodapé Unificado Card 1 -->
            <div id="container-buttons">
                <div class="card-footer-info" id="info-feminina" style="{{#if medida_sob_medida_feminina.0.id}}display:flex;{{else if medida_sob_medida_masculina.0.id}}display:none;{{else}}display:flex;{{/if}}">
                    <i class="far fa-clock"></i>
                    {{#if medida_sob_medida_feminina.0.id}}
                        <span>Atualizado em <strong>{{data_brasileira medida_sob_medida_feminina.0.atualizacao.data}} às {{medida_sob_medida_feminina.0.atualizacao.hora}}</strong></span>
                    {{else}}
                        <span><strong>Sem Medida Sob Medida Feminina!</strong></span>
                    {{/if}}
                </div>
                <div class="card-footer-info" id="info-masculina" style="{{#if medida_sob_medida_feminina.0.id}}display:none;{{else if medida_sob_medida_masculina.0.id}}display:flex;{{else}}display:none;{{/if}}">
                    <i class="far fa-clock"></i>
                    {{#if medida_sob_medida_masculina.0.id}}
                        <span>Atualizado em <strong>{{data_brasileira medida_sob_medida_masculina.0.atualizacao.data}} às {{medida_sob_medida_masculina.0.atualizacao.hora}}</strong></span>
                    {{else}}
                        <span><strong>Sem Medida Sob Medida Masculina!</strong></span>
                    {{/if}}
                </div>
                <div class="card-footer-actions" id="actions-feminina" style="{{#if medida_sob_medida_feminina.0.id}}display:flex;{{else if medida_sob_medida_masculina.0.id}}display:none;{{else}}display:flex;{{/if}} gap:0.5rem; flex-wrap: wrap;">
                    {{#if medida_sob_medida_feminina.0.id}}
                        <button class="btn btn-outline-danger" onclick="abrirModalSobMedidaFeminina({{id}})">
                            <i class="far fa-trash-alt"></i> Limpar Feminina
                        </button>
                        <button class="btn btn-primary" onclick="atualizarMedidasSobMedidaFeminina({{medida_sob_medida_feminina.0.id}})">
                            <i class="fas fa-pen"></i> Atualizar Feminina
                        </button>
                    {{else}}
                        <button class="btn btn-outline-secondary" disabled>Limpar Feminina</button>
                        <button class="btn btn-primary btn-adicionar-sob-medida" onclick="cadastrarMedidasSobMedidaFeminina({{id}})">
                            <i class="fas fa-plus"></i> Adicionar Feminina
                        </button>
                    {{/if}}
                </div>
                <div class="card-footer-actions" id="actions-masculina" style="{{#if medida_sob_medida_feminina.0.id}}display:none;{{else if medida_sob_medida_masculina.0.id}}display:flex;{{else}}display:none;{{/if}} gap:0.5rem; flex-wrap: wrap;">
                    {{#if medida_sob_medida_masculina.0.id}}
                        <button class="btn btn-outline-danger" onclick="abrirModalSobMedidaMasculina({{id}})">
                            <i class="far fa-trash-alt"></i> Limpar Masculina
                        </button>
                        <button class="btn btn-primary" onclick="atualizarMedidasSobMedidaMasculina({{medida_sob_medida_masculina.0.id}})">
                            <i class="fas fa-pen"></i> Atualizar Masculina
                        </button>
                    {{else}}
                        <button class="btn btn-outline-secondary" disabled>Limpar Masculina</button>
                        <button class="btn btn-primary btn-adicionar-sob-medida" onclick="cadastrarMedidasSobMedidaMasculina({{id}})">
                            <i class="fas fa-plus"></i> Adicionar Masculina
                        </button>
                    {{/if}}
                </div>
            </div>
        </section>

        <!-- CARD 2: MEDIDA PADRÃO -->
        <section class="card-medida">
            <div class="card-header-medida">
                <h2>
                    <i class="fas fa-tshirt"></i>
                    Medida Padrão
                </h2>
                <span class="header-tag">Padrão</span>
            </div>

            <div class="card-body-medida">
                {{#if medida_padrao.0.id}}
                    <div class="secao-padrao">
                        <div class="campo-padrao-group">
                            <label class="campo-label">Sexo</label>
                            <div class="badge-sexo">
                                <i class="fas fa-genderless"></i>
                                {{mostrar medida_padrao.0.sexo}}
                            </div>
                        </div>

                        <div class="campo-padrao-group">
                            <label class="campo-label">Tamanho</label>
                            <div class="badge-tamanho">
                                <i class="fas fa-tag"></i>
                                {{mostrar medida_padrao.0.tamanho}}
                            </div>
                        </div>

                        <div class="campo-padrao-group">
                            <label class="campo-label">Ajuste</label>
                            <div class="ajuste-wrapper">
                                <div class="ajuste-box-limited" title="{{medida_padrao.0.ajuste}}">
                                    {{#if medida_padrao.0.ajuste}}
                                        {{~mostrar medida_padrao.0.ajuste~}}
                                    {{else}}
                                        <span class="text-muted">Nenhum ajuste informado.</span>
                                    {{/if}}
                                </div>

                                <div class="tooltip-container">
                                    <button type="button" 
                                            class="btn-ajuste-modal" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#modalAjuste">
                                        <i class="fas fa-file-alt"></i>
                                    </button>
                                    <span class="custom-tooltip">Visualizar ajuste detalhado</span>
                                </div>
                            </div>
                        </div>
                    </div>
                {{else}}
                    <div class="empty-state-card">
                        <i class="fas fa-tshirt text-muted mb-2" style="font-size: 2rem;"></i>
                        <p class="text-muted mb-0">Nenhuma medida padrão cadastrada.</p>
                    </div>
                {{/if}}
            </div>

            <!-- Rodapé Unificado Card 2 -->
            <div id="container-buttons">
                <div class="card-footer-info">
                    <i class="far fa-clock"></i>
                    {{#if medida_padrao.0.id}}
                        <span>Atualizado em <strong>{{data_brasileira medida_padrao.0.atualizacao.data}} às {{medida_padrao.0.atualizacao.hora}}</strong></span>
                    {{else}}
                        <span><strong>Sem Medida Padrão!</strong></span>
                    {{/if}}
                </div>
                <div class="card-footer-actions">
                    {{#if medida_padrao.0.id}}
                        <button class="btn btn-outline-danger" onclick="abrirModalpadrao()">
                            <i class="far fa-trash-alt"></i> Limpar
                        </button>
                        <button class="btn btn-primary" onclick="atualizarMedidasPadrao({{medida_padrao.0.id}})">
                            <i class="fas fa-pen"></i> Atualizar
                        </button>
                    {{else}}
                        <button class="btn btn-outline-secondary" disabled>Limpar</button>
                        <button class="btn btn-primary" onclick="cadastrarMedidasPadrao({{id}})">
                            <i class="fas fa-plus"></i> Adicionar
                        </button>
                    {{/if}}
                </div>
            </div>
        </section>

    </div>

    <!-- Banner Informativo -->
    <div class="info-banner-card">
        <div class="info-banner-content">
            <div class="info-icon">
                <i class="fas fa-info"></i>
            </div>
            <div>
                <h4>Informações</h4>
                <p>As medidas sob medida são utilizadas para peças personalizadas.<br>
                As medidas padrão são utilizadas como referência para novos pedidos.</p>
            </div>
        </div>
        <div class="info-banner-illustration">
            <svg viewBox="0 0 200 60" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M10 30 Q 50 10, 100 30 T 190 30" stroke="#cbd5e1" stroke-width="2" stroke-dasharray="4 4"/>
                <circle cx="150" cy="30" r="15" stroke="#cbd5e1" stroke-width="2"/>
            </svg>
        </div>
    </div>

    <!-- Modais de Confirmação -->
    <div class="modal fade" tabindex="-1" id="meumodal">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content delete-modal">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-exclamation-triangle text-warning me-2"></i> Excluir Medida Sob Medida Feminina</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-1">Tem certeza que deseja excluir esta medida?</p>
                    <small class="text-muted">Essa ação não poderá ser desfeita.</small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger" onclick="deletarMedidaSobMedidaFeminina({{medida_sob_medida_feminina.0.id}})">Excluir Feminina</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" tabindex="-1" id="meumodalmasculino">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content delete-modal">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-exclamation-triangle text-warning me-2"></i> Excluir Medida Sob Medida Masculina</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-1">Tem certeza que deseja excluir esta medida?</p>
                    <small class="text-muted">Essa ação não poderá ser desfeita.</small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger" onclick="deletarMedidaSobMedidaMasculina({{medida_sob_medida_masculina.0.id}})">Excluir Masculina</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" tabindex="-1" id="meumodalpadrao">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content delete-modal">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-exclamation-triangle text-warning me-2"></i> Excluir Medida Padrão</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-1">Tem certeza que deseja excluir esta medida?</p>
                    <small class="text-muted">Essa ação não poderá ser desfeita.</small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger" onclick="deletarMedidaPadrao({{medida_padrao.0.id}}, '{{medida_padrao.0.sexo}}')">Excluir</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalAjuste" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content ajuste-modal">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="fas fa-file-alt me-2 text-primary"></i> Ajustes da Medida</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="texto-ajuste-modal">
                        {{#if medida_padrao.0.ajuste}}
                            {{~mostrar medida_padrao.0.ajuste~}}
                        {{else}}
                            <span class="text-muted">Nenhum ajuste informado.</span>
                        {{/if}}
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Fechar</button>
                </div>
            </div>
        </div>
    </div>
</div>
