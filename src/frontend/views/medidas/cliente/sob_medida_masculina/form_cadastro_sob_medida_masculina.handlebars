<button id="back" type="button" onclick="voltar()"><i class="fas fa-home"></i></button>
{{#if msg}}
<div id="msg" class="d-flex gap-3 alert alert-success alert-dismissible fade show position-fixed top-0 end-0 me-5 m-3">
    <i class="bi bi-check-square-fill text-success"></i>
    <p class="fw-bold mb-0">{{msg}}</p>
</div>
{{/if}}
{{#if error}}
<div id="errordiv" class="d-flex gap-3 alert alert-danger alert-dismissible fade show position-fixed top-0 end-0 me-5 m-3">
    <i class="bi bi-x-square-fill text-danger"></i>
    <p class="fw-bold mb-0">{{error}}</p>
</div>
{{/if}}
<div class="page-shell">
    <div class="form-card">
        <div class="card-body">
            <h1 class="form-title">Cadastro de Sob Medida</h1>
            <p class="form-subtitle">Registre as medidas específicas para o cliente com o mesmo padrão visual das telas de pedido.</p>

            <form id="form" class="row g-3">

                <div class="col-12 col-md-6">
                    <label for="inputOmbro" class="form-label">Ombro</label>
                    <input class="form-control" id="inputOmbro" name="ombro">
                </div>

                <div class="col-12 col-md-6">
                    <label for="inputCircunferenciaTorax" class="form-label">Circunferencia do Torax</label>
                    <input class="form-control" id="inputCircunferenciaTorax" name="circunferencia_torax">
                </div>

                <div class="col-12 col-md-6">
                    <label for="inputCircunferenciaAbdomen" class="form-label">Circunferencia do Abdomen</label>
                    <input class="form-control" id="inputCircunferenciaAbdomen" name="cicunferencia_abdomen">
                </div>

                <div class="col-12 col-md-6">
                    <label for="inputCosta" class="form-label">Costa</label>
                    <input class="form-control" id="inputCosta" name="costa">
                </div>

                <div class="col-12 col-md-6">
                    <label for="inputComprimentoManga" class="form-label">Comprimento da Manga</label>
                    <input class="form-control" id="inputComprimentoManga" name="comprimento_manga">
                </div>

                <div class="col-12 col-md-6">
                    <label for="inputLarguraPunho" class="form-label">Largura do Punho</label>
                    <input class="form-control" id="inputLarguraPunho" name="largura_punho">
                </div>

                <div class="col-12 col-md-6">
                    <label for="inputLarguraManga" class="form-label">Largura do Manga</label>
                    <input class="form-control" id="inputLarguraManga" name="largura_manga">
                </div>

                <div class="col-12 col-md-6">
                    <label for="inputComprimentoCorpo" class="form-label">Comprimento do Corpo</label>
                    <input class="form-control" id="inputComprimentoCorpo" name="comprimento_corpo">
                </div>

                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-primary">Enviar</button>
                </div>
            </form>
        </div>
    </div>
</div>    
