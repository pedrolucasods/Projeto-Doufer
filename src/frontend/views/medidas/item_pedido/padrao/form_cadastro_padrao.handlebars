<main class="measurement-form-page">
	{{#if msg}}
		<div id="msg" class="alert alert-success alert-dismissible fade show form-alert" role="alert">
			<i class="bi bi-check-circle-fill"></i><span>{{msg}}</span>
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
		</div>
	{{/if}}
	{{#if error}}
		<div id="errordiv" class="alert alert-danger alert-dismissible fade show form-alert" role="alert">
			<i class="bi bi-exclamation-circle-fill"></i><span>{{error}}</span>
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
		</div>
	{{/if}}

	<header class="measurement-form-header">
		<button id="back" type="button" onclick="voltar({{item_id}})" title="Voltar" aria-label="Voltar"><i class="fas fa-arrow-left"></i></button>
		<div>
			<span class="form-eyebrow"><i class="fas fa-ruler-combined"></i> Item do pedido #{{item_id}}</span>
			<h1>Nova medida padrão</h1>
			<p>Defina o tamanho e o ajuste padrão para este item.</p>
		</div>
		<span class="standard-badge"><i class="fas fa-ruler"></i> Padrão</span>
	</header>

	<section class="item-summary" aria-label="Dados do item do pedido">
		<div class="summary-heading"><span class="section-kicker">Item selecionado</span><h2>{{produto}}</h2></div>
		<div class="summary-grid">
			<div class="summary-field"><span>Cliente</span><strong>{{cliente}}</strong></div>
			<div class="summary-field"><span>Pedido</span><strong>#{{pedido_id}}</strong></div>
			<div class="summary-field"><span>Item</span><strong>#{{item_id}}</strong></div>
			<div class="summary-field"><span>Modelo</span><strong>{{modelo_produto}}</strong></div>
			<div class="summary-field"><span>Cor</span><strong>{{cor}}</strong></div>
			<div class="summary-field summary-available"><span>Quantidade disponível</span><strong>{{quantidade_disponivel}}</strong></div>
		</div>
	</section>

	<form id="formAddMedidaPadraoItemPedido" class="measurement-form">
		<input type="hidden" name="tipo_medida" value="padrao">
		<input type="hidden" name="item_pedido_id" value="{{item_id}}">

		<section class="form-section" aria-labelledby="quantity-title">
			<div class="section-heading">
				<div class="section-icon"><i class="fas fa-layer-group"></i></div>
				<div><span class="section-kicker">Produção</span><h2 id="quantity-title">Quantidade</h2></div>
			</div>
			<div class="field-group quantity-field">
				<label for="quantidade">Quantidade de peças</label>
				<input class="form-control" type="number" id="quantidade" name="quantidade" min="1" max="{{quantidade_disponivel}}" value="1" required>
				<small>Até {{quantidade_disponivel}} peça(s) disponíveis para este item.</small>
			</div>
		</section>

		<section class="form-section" aria-labelledby="standard-title">
			<div class="section-heading">
				<div class="section-icon"><i class="fas fa-tags"></i></div>
				<div><span class="section-kicker">Configuração</span><h2 id="standard-title">Tamanho e ajuste</h2></div>
			</div>
			<div class="measurement-grid">
				<div class="field-group">
					<label for="sexo">Sexo</label>
					<select class="form-select" id="sexo" name="medidas[0][sexo]" required>
						<option value="">Selecione o sexo</option>
						<option value="masculino">Masculino</option>
						<option value="feminino">Feminino</option>
					</select>
				</div>
				<div class="field-group">
					<label for="tamanho">Tamanho</label>
					<select class="form-select" id="tamanho" name="medidas[0][tamanho]" required>
						<option value="">Selecione o tamanho</option>
						<option value="PP">PP</option>
						<option value="P">P</option>
						<option value="M">M</option>
						<option value="G">G</option>
						<option value="GG">GG</option>
						<option value="EXG">EXG</option>
						<option value="SEGUIR MEDIDA">SEGUIR MEDIDA</option>
					</select>
				</div>
				<div class="field-group field-group-wide">
					<label for="ajuste">Ajuste</label>
					<textarea class="form-control" id="ajuste" name="medidas[0][ajuste]" rows="4" placeholder="Descreva o ajuste desejado"></textarea>
					<small>Informe detalhes de modelagem ou acabamento quando necessário.</small>
				</div>
			</div>
		</section>

		<footer class="form-actions">
			<p><i class="fas fa-info-circle"></i> Use esta medida para registrar um tamanho fixo e um ajuste definido.</p>
			<button type="submit" class="save-button"><i class="fas fa-check"></i> Salvar medida</button>
		</footer>
	</form>
</main>
