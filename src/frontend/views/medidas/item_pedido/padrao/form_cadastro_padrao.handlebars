<button id="back" type="button" onclick="voltar({{pedido_id}})"><i class="fas fa-home"></i></button>
{{#if msg}}
<div id="msg" class="d-flex gap-3 alert alert-success alert-dismissible fade show position-fixed top-0 end-0 me-5 m-3">
    <i class="bi bi-check-square-fill text-success"></i>
    <p class="fw-bold mb-0">{{msg}}</p>
</div>
{{/if}}
{{#if error}}
<div id="errordiv" class="d-flex gap-3 alert alert-danger alert-dismissible fade show position-fixed top-0 end-0 me-5 m-3">
    <i class="bi bi-x-square-fill text-danger"></i>
    <p class="fw-bold mb-0">{{error}}</p>
</div>
{{/if}}

<section class="page-section py-5 bg-light">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-xl-9 col-lg-10">
                <div class="card border-0 shadow-sm overflow-hidden add-medida-card">
                    <div class="card-body p-5">
                        <div class="d-flex justify-content-between align-items-start mb-4">
                            <div>
                                <h1 class="h3 fw-bold mb-2">Medida Padrão do Item do Pedido</h1>
                                <p class="text-muted mb-0">Cadastre o tamanho e o ajuste padrão para este item do pedido.</p>
                            </div>
                            <span class="badge bg-secondary text-uppercase">Item</span>
                        </div>

                        <div class="info-panel mb-4">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="info-item">
                                        <span class="label">Cliente</span>
                                        <strong>{{cliente}}</strong>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="info-item">
                                        <span class="label">Pedido</span>
                                        <strong>#{{pedido_id}}</strong>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="info-item">
                                        <span class="label">Item</span>
                                        <strong>#{{item_id}}</strong>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="info-item">
                                        <span class="label">Quantidade disponível</span>
                                        <strong>{{quantidade_disponivel}}</strong>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="info-item">
                                        <span class="label">Produto</span>
                                        <strong>{{produto}}</strong>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="info-item">
                                        <span class="label">Modelo</span>
                                        <strong>{{modelo_produto}}</strong>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="info-item">
                                        <span class="label">Cor</span>
                                        <strong>{{cor}}</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <form id="formAddMedidaPadraoItemPedido" class="row g-3">
                            <input type="hidden" name="tipo_medida" value="padrao">
                            <input type="hidden" name="item_pedido_id" value="{{item_id}}">

                            <div class="col-12 col-md-6">
                                <label for="quantidade" class="form-label">Quantidade</label>
                                <input class="form-control" type="number" id="quantidade" name="quantidade" min="1" max="{{quantidade_disponivel}}" value="1" required>
                            </div>

                            <div class="col-12">
                                <label for="sexo" class="form-label">Sexo</label>
                                <select class="form-select" id="sexo" name="medidas[0][sexo]" required>
                                    <option value="">Selecione o sexo</option>
                                    <option value="masculino">Masculino</option>
                                    <option value="feminino">Feminino</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label for="tamanho" class="form-label">Tamanho</label>
                                <select class="form-select" id="tamanho" name="medidas[0][tamanho]" required>
                                    <option value="">Selecione o tamanho</option>
                                    <option value="PP">PP</option>
                                    <option value="P">P</option>
                                    <option value="M">M</option>
                                    <option value="G">G</option>
                                    <option value="GG">GG</option>
                                    <option value="EXG">EXG</option>
                                    <option value="SEGUIR MEDIDA">SEGUIR MEDIDA</option>
                                </select>
                            </div>

                            <div class="col-12">
                                <label for="ajuste" class="form-label">Ajuste</label>
                                <textarea class="form-control" id="ajuste" name="medidas[0][ajuste]" rows="4" placeholder="Descreva o ajuste desejado" required></textarea>
                            </div>

                            <div class="col-12">
                                <label class="form-label">Descrição rápida</label>
                                <div class="form-text text-muted">Use esta medida padrão para registrar um tamanho fixo e ajuste definido para o item do pedido.</div>
                            </div>

                            <div class="col-12 text-end">
                                <button type="submit" class="btn btn-primary btn-md px-4">Salvar Medida</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
