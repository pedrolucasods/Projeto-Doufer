<main class="sob-medida-page">
	{{#if msg}}
		<div id="msg" class="alert alert-success alert-dismissible fade show" role="alert">
			<i class="bi bi-check-square-fill"></i><span>{{msg}}</span>
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
		</div>
	{{/if}}
	{{#if error}}
		<div id="errordiv" class="alert alert-danger alert-dismissible fade show" role="alert">
			<i class="bi bi-x-square-fill"></i><span>{{error}}</span>
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fechar"></button>
		</div>
	{{/if}}

	<header class="sob-medida-header">
		<a class="icon-button" onclick="voltar({{item_id}})" title="Voltar" aria-label="Voltar">
			<i class="fas fa-arrow-left"></i>
		</a>
		<div class="header-copy">
			<span class="eyebrow"><i class="fas fa-ruler-combined"></i> Item do pedido #{{item_id}}</span>
			<h1>Medidas sob medida</h1>
			<p>{{produto}} <span aria-hidden="true">/</span> {{cor}} <span aria-hidden="true">/</span> {{cliente_nome}}</p>
		</div>
		<div class="quantity-summary">
			<span>Disponíveis</span><strong>{{quantidade_disponivel}}</strong><small>de {{quantidade_produto}} peças</small>
		</div>
	</header>

	<section class="sob-medida-toolbar" aria-label="Resumo das medidas">
		<div class="toolbar-heading">
			<span class="section-kicker">Registros personalizados</span>
			<h2>{{quantidade_medidas}} medidas sob medida</h2>
		</div>
		{{#if quantidade_disponivel}}
			<a class="add-button" onclick="cadastrar({{item_id}})">
				<i class="fas fa-plus"></i><span>Adicionar medida sob medida</span>
			</a>
		{{/if}}
	</section>

	{{#if medida.length}}
		<section class="sob-medidas-list" aria-label="Medidas sob medida cadastradas">
			{{#each medida}}
				<article class="sob-medida-card">
					<div class="card-accent" aria-hidden="true"></div>
					<header class="sob-card-heading">
						<div><span class="measure-number">Registro {{@index}}</span><h3>{{mostrar sexo}}</h3></div>
						<span class="quantity-badge"><i class="fas fa-layer-group"></i> {{quantidade}} un.</span>
					</header>
					<div class="fields-grid">
						<div class="measure-field"><span title="Busto">Busto</span><strong>{{busto}}</strong></div>
						<div class="measure-field"><span title="Cintura">Cintura</span><strong>{{cintura}}</strong></div>
						<div class="measure-field"><span title="Quadril">Quadril</span><strong>{{quadril}}</strong></div>
						<div class="measure-field"><span title="Comprimento">Comprimento</span><strong>{{comprimento}}</strong></div>
						<div class="measure-field"><span title="Ombro">Ombro</span><strong>{{ombro}}</strong></div>
						<div class="measure-field"><span title="Costas">Costas</span><strong>{{costas}}</strong></div>
						<div class="measure-field"><span title="Comprimento da manga">Comprimento da manga</span><strong>{{comprimento_da_manga}}</strong></div>
						<div class="measure-field"><span title="Largura da manga">Largura da manga</span><strong>{{largura_da_manga}}</strong></div>
					</div>
					<footer class="sob-card-footer">
						<small><i class="far fa-clock"></i> {{#if atualizacao.data}}Atualizada em {{data_brasileira atualizacao.data}} às {{atualizacao.hora}}{{else}}Medida cadastrada{{/if}}</small>
						<div class="card-actions">
							<a class="card-action edit-action" onclick="atualizar({{id}})" title="Editar medida" aria-label="Editar medida"><i class="fas fa-pencil-alt"></i></a>
							<button type="button" class="card-action delete-action" data-bs-toggle="modal" data-bs-target="#modalExcluirMedidaSobMedida" title="Excluir medida" aria-label="Excluir medida"><i class="fas fa-trash-alt"></i></button>
						</div>
					</footer>
				</article>
			{{/each}}
		</section>
	{{else}}
		<section class="empty-measures" aria-live="polite">
			<div class="empty-mark"><i class="fas fa-ruler-horizontal"></i></div>
			<span class="section-kicker">Nenhum registro ainda</span>
			<h2>Este item ainda não tem medida sob medida</h2>
			<p>Cadastre uma medida para definir as proporções usadas neste item do pedido.</p>
			{{#if quantidade_disponivel}}
				<a class="add-button" href="/medidas/itens-pedidos/{{item_id}}/cadastro/SobMedida"><i class="fas fa-plus"></i><span>Adicionar medida sob medida</span></a>
			{{else}}
				<button type="button" class="add-button" disabled><i class="fas fa-lock"></i><span>Quantidade esgotada</span></button>
			{{/if}}
		</section>
	{{/if}}
</main>

<div class="modal fade" id="modalExcluirMedidaSobMedida" tabindex="-1" aria-labelledby="modalExcluirMedidaSobMedidaLabel" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered"><div class="modal-content delete-modal">
		<div class="modal-header"><div class="modal-title-wrap"><span class="modal-warning"><i class="fas fa-trash-alt"></i></span><h2 class="modal-title" id="modalExcluirMedidaSobMedidaLabel">Excluir medida sob medida?</h2></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div>
		<div class="modal-body"><p>Esta medida será removida do item do pedido.</p><small>Essa ação não poderá ser desfeita.</small></div>
		<div class="modal-footer"><button type="button" class="cancel-button" data-bs-dismiss="modal">Cancelar</button><button type="button" class="confirm-delete-button"><i class="fas fa-trash-alt"></i> Excluir medida</button></div>
	</div></div>
</div>
