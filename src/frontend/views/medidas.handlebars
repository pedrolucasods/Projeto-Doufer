<button class="btn btn-primary" onclick="voltar({{cliente.id}})">Voltar</button>
{{#if msg}}
<div id="msg" class="d-flex gap-3 alert alert-success alert-dismissible fade show position-fixed top-0 end-0 me-5 m-3">
    <i class="bi bi-check-square-fill text-success"></i>
    <p class="fw-bold mb-0">{{msg}}</p>
</div>
{{/if}}
{{#if error}}
<div id="errordiv" class="d-flex gap-3 alert alert-danger alert-dismissible fade show position-fixed top-0 end-0 me-5 m-3">
    <i class="bi bi-x-square-fill text-danger"></i>
    <p class="fw-bold mb-0">{{error}}</p>
</div>
{{/if}}
<div id="container">
    <div class="container-infos">
        <div class="container-title">
            <p id="title-cliente">Medidas de {{cliente.nome}}</p>
        </div>
        
        <div id="container-medidas" class=" border border-2 p-4 rounded-3">
            <div class="medidas-sobmedida">
                <div class="medidas-corpos">
                    <p id="title-corpo">Medidas do corpo</p>
                    <div id="medidas-corpo" class="border p-3 rounded">
                        <div id="medidas-coluna1">
                            <p>Busto: {{mostrar cliente.medida_sob_medida.0.busto}}</p>
                            <p>Cintura: {{mostrar cliente.medida_sob_medida.0.cintura}}</p>
                            <p>Quadril: {{mostrar cliente.medida_sob_medida.0.quadril}}</p>
                            <p>Comprimento: {{mostrar cliente.medida_sob_medida.0.comprimento}}</p>
                        </div>
                        <div id="medidas-coluna2">
                            <p>Ombro: {{mostrar cliente.medida_sob_medida.0.ombro}}</p>
                            <p>Costas: {{mostrar cliente.medida_sob_medida.0.costas}}</p>
                        </div>
                    </div>
                </div>
                
                <div class="medidas-manga">
                    <p id="title-manga">Medidas da manga</p>
                    <div id="medidas-manga" class="border p-3 rounded">
                        <p>Comprimento da Manga: {{mostrar cliente.medida_sob_medida.0.comprimento_da_manga}}</p>
                        <p>Largura da Manga: {{mostrar cliente.medida_sob_medida.0.largura_da_manga}}</p>
                    </div>
                    <div id="container-buttons">
                        {{#if cliente.medida_sob_medida.0.id}}
                        <button class="btn btn-danger" onclick="abrirModalSobMedida({{cliente.id}})">Limpar</button>
                        <button class="btn btn-success" onclick="atualizarMedidasSobMedida({{cliente.medida_sob_medida.0.id}})">Atualizar</button>
                        {{else}}
                        <button class="btn btn-secondary" disabled>Limpar</button>
                        <button class="btn btn-success" onclick="cadastrarMedidas({{cliente.id}})">Adicionar</button>
                        {{/if}}
                    </div>
                </div>
            </div>
            
            <div class="medidas-padrao border p-4 rounded-3">
                <p id="title-corpo">Medidas Padrão</p>
                <div id="medidas-padrao" class="border p-3 rounded">
                    <div id="medidas-coluna1">
                        <p>Tamanho: {{mostrar cliente.medida_padrao.0.tamanho}}</p>
                        <p>Ajuste: {{mostrar cliente.medida_padrao.0.ajuste}}</p>
                    </div>
                    <div id="container-buttons">
                        {{#if cliente.medida_padrao.0.id}}
                        <button class="btn btn-danger" onclick="abrirModalpadrao()">Limpar</button>
                        <button class="btn btn-success" onclick="atualizarMedidasPadrao({{cliente.medida_padrao.0.id}})">Atualizar</button>
                        {{else}}
                        <button class="btn btn-secondary" disabled>Limpar</button>
                        <button class="btn btn-success" onclick="cadastrarMedidasPadrao({{cliente.id}})">Adicionar</button>
                        {{/if}}
                    </div>
                </div>
            </div>
        </div>

        <div class="modal" tabindex="-1" id="meumodal">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content delete-modal">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Confirmação de exclusão</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-2">Tem certeza que deseja excluir a medida sob medida?</p>
                        <p class="text-muted">Essa ação não poderá ser desfeita.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" class="btn btn-danger" onclick="deletarMedidaSobMedida({{cliente.medida_sob_medida.0.id}})">Excluir</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal" tabindex="-1" id="meumodalpadrao">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content delete-modal">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Confirmação de exclusão</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-2">Tem certeza que deseja excluir a medida padrão?</p>
                        <p class="text-muted">Essa ação não poderá ser desfeita.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="button" class="btn btn-danger" onclick="deletarMedidaPadrao({{cliente.medida_padrao.0.id}})">Excluir</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
</div>