{{#if msg}}
    <div id="msg" class="d-flex gap-3 alert alert-success alert-dismissible fade show position-fixed top-0 end-0 me-5 m-3">
        <i class="bi bi-check-square-fill text-success"></i>
        <p class="fw-bold mb-0">{{msg}}</p>
    </div>
{{/if}}
{{#if error}}
    <div id="errordiv" class="d-flex gap-3 alert alert-danger alert-dismissible fade show position-fixed top-0 end-0 me-5 m-3">
        <i class="bi bi-x-square-fill text-danger"></i>
        <p class="fw-bold mb-0">{{error}}</p>
    </div>
{{/if}}
<button id="back" type="button"><i class="fas fa-home"></i></button>

<div class="page-shell">
    <div class="form-card">
        <div class="card-body">
            {{#if clientes.length}}
                <h1 class="form-title">Criar Pedido</h1>
                <p class="form-subtitle">Cadastre um novo pedido e adicione os itens abaixo.</p>
                <form id="formaddpedido">
                    <input type="hidden" id="tipo_cliente" value="{{tipoCliente}}">
                    <label class="form-label" for="selectcliente">Cliente:</label>
                    <select class="form-select" id="selectcliente" name="cliente">
                        {{#each clientes}}
                            <option value="{{this.id}}">{{this.nome}}</option>
                        {{/each}}
                    </select>
                    <br><br>
                    <label class="form-label" for="data_pedido">Data pedido</label>
                    <input class="form-control" type="date" id="data_input" required value="{{hoje}}">
                    <br><br>
                    <hr>
                    <h3 class="form-title" style="font-size: 1.2rem;">Itens do Pedido</h3>
                    <div id="itens-container">
                        <label class="form-label">Produto:</label>
                        <input class="form-control" id="nome-produto">
                        <br><br>

                        <label class="form-label">Cor:</label>
                        <input class="form-control" id="cor-produto">
                        <br><br>

                        <label class="form-label">Tecido:</label>
                        <input class="form-control" id="tecido-produto">
                        <br><br>

                        <label class="form-label">Tamanho:</label>
                        <input class="form-control" id="tamanho-produto">
                        <br><br>

                        <label class="form-label">Detalhes</label>
                        <input class="form-control" id="detalhes-produto">
                        <br><br>

                        <label class="form-label">Quantidade:</label>
                        <input class="form-control" id="quantidade-produto" type="number">
                        <br><br>

                        <label class="form-label">Modelo do Produto:</label>
                        <input class="form-control" id="modelo-produto">
                        <br><br>

                        <label class="form-label">Preço Unitário:</label>
                        <input class="form-control" id="precouni-produto">
                        <br><br>

                        <label class="form-label">Complemento:</label>
                        <input class="form-control" id="complemento-produto">
                        <br><br>

                        <button type="button" id="btn-add-item">
                            <i class="fa-solid fa-plus"></i> Adicionar Item
                        </button>

                        <div id="itens"></div>
                    </div>
                    <hr>
                    <div class="text-end">
                        <button type="submit">Salvar Pedido!</button>
                    </div>
                </form>

        <!-- Modal de confirmação -->
        <div id="modalConfirm" style="display: none; position: fixed; top: 0; left: 0; 
                width: 100%; height: 100%; background-color: rgba(0,0,0,0.6); 
                z-index: 999; justify-content: center; align-items: center;">

            <div style="background-color: white; padding: 20px; border-radius: 10px; text-align: center;">
                <h2 id="modalMensagem">Tem certeza que deseja excluir este item?</h2>
                <br>
                <button id="btnConfirmar">Sim</button>
                <button id="btnCancelar">Cancelar</button>
            </div>
        </div>
        <!-- Modal Aviso -->
        <div id="modalAviso" style="display: none; position: fixed; top: 0; left: 0; 
                width: 100%; height: 100%; background-color: rgba(0,0,0,0.6); 
                z-index: 999; justify-content: center; align-items: center;">

            <div style="background-color: white; padding: 20px; border-radius: 10px; text-align: center;">
                <h2 id="avisoMensagem">Preencha corretamente o nome do produto, quantidade e preço unitário!</h2>
                <br>
                <button id="btnOK">Ok</button>
            </div>
        </div>
            {{else}}
                <h1 class="form-title">Você não possui nenhum cliente cadastrado para criar um pedido!</h1>
            {{/if}}
        </div>
    </div>
</div>
