<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Doufer</title>
    <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
  />
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="/icons/bootstrap-icons.css">
    <script>
        if (localStorage.getItem('doufer-sidebar-collapsed') === 'true' && window.matchMedia('(min-width: 768px)').matches) {
            document.documentElement.classList.add('sidebar-collapsed');
        }
        const temaSalvo = localStorage.getItem('doufer-theme') || 'azul';
        document.documentElement.dataset.theme = temaSalvo;
    </script>
    {{#if stylesheet}}
        <link rel="stylesheet"  href="/css/{{stylesheet}}">
    {{/if}}
    <link rel="stylesheet" href="/css/themes.css">
    <link rel="stylesheet" href="/css/sidebar.css">
</head>
<body>
    <aside class="sidebar" id="sidebar" aria-label="Navegação principal">
        <div class="sidebar-header">
            <a class="sidebar-brand" href="/" aria-label="Ir para a página inicial">
                <span class="sidebar-brand-mark">D</span>
                <span class="sidebar-label">Doufer</span>
            </a>
            <button class="sidebar-toggle" id="sidebar-toggle" type="button" aria-label="Recolher menu" aria-expanded="true" title="Recolher menu">
                <i class="fas fa-chevron-left" aria-hidden="true"></i>
            </button>
        </div>

        <nav class="sidebar-nav">
            <a class="sidebar-link" href="/pedidos" data-route="/pedidos">
                <i class="fas fa-receipt" aria-hidden="true"></i>
                <span class="sidebar-label">Pedidos</span>
            </a>
            <a class="sidebar-link" href="/clientes" data-route="/clientes">
                <i class="fas fa-users" aria-hidden="true"></i>
                <span class="sidebar-label">Clientes</span>
            </a>
            <a class="sidebar-link" href="/orcamentos" data-route="/orcamentos">
                <i class="fas fa-file-invoice-dollar" aria-hidden="true"></i>
                <span class="sidebar-label">Orçamentos</span>
            </a>
            <a class="sidebar-link" href="/funcionarios" data-route="/funcionarios">
                <i class="fas fa-user-tie" aria-hidden="true"></i>
                <span class="sidebar-label">Funcionários</span>
            </a>
        </nav>

        <div class="sidebar-footer">
            <button class="sidebar-link sidebar-theme-button" id="theme-button" type="button" aria-haspopup="dialog">
                <i class="fas fa-palette" aria-hidden="true"></i>
                <span class="sidebar-label">Tema</span>
            </button>
            <a class="sidebar-home" href="/">
                <i class="fas fa-house" aria-hidden="true"></i>
                <span class="sidebar-label">Início</span>
            </a>
        </div>
    </aside>
    <div class="sidebar-backdrop" id="sidebar-backdrop"></div>
    <div class="theme-modal" id="theme-modal" role="dialog" aria-modal="true" aria-labelledby="theme-modal-title" hidden>
        <div class="theme-modal-card">
            <div class="theme-modal-header">
                <div>
                    <span class="theme-modal-kicker">Personalização</span>
                    <h2 id="theme-modal-title">Escolha um tema</h2>
                </div>
                <button class="theme-modal-close" id="theme-modal-close" type="button" aria-label="Fechar escolha de tema">&times;</button>
            </div>
            <div class="theme-options" role="group" aria-label="Temas disponíveis">
                <button class="theme-option" type="button" data-theme-choice="azul"><span class="theme-swatch theme-swatch-blue"></span>Azul</button>
                <button class="theme-option" type="button" data-theme-choice="escuro"><span class="theme-swatch theme-swatch-dark"></span>Tema escuro</button>
                <button class="theme-option" type="button" data-theme-choice="claro"><span class="theme-swatch theme-swatch-light"></span>Tema claro</button>
                <button class="theme-option" type="button" data-theme-choice="verde"><span class="theme-swatch theme-swatch-green"></span>Verde</button>
                <button class="theme-option" type="button" data-theme-choice="rosa"><span class="theme-swatch theme-swatch-pink"></span>Rosa</button>
                <button class="theme-option" type="button" data-theme-choice="vermelho"><span class="theme-swatch theme-swatch-red"></span>Vermelho</button>
                <button class="theme-option" type="button" data-theme-choice="ciano"><span class="theme-swatch theme-swatch-cyan"></span>Ciano</button>
            </div>
        </div>
    </div>
    <main class="app-content">
        {{{body}}}
    </main>
    

    <script src="https://unpkg.com/imask"></script>
    <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/javascript/sidebar.js"></script>
    <script src="/javascript/themes.js"></script>

    {{#if script}}
        <script src="/javascript/{{script}}"></script>
    {{/if}}
</body>

    
</html>