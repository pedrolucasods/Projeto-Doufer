{{#if msg}}
<div id="msg" class="d-flex gap-3 alert alert-success alert-dismissible fade show position-fixed top-0 end-0 me-5 m-3">
    <i class="bi bi-check-square-fill text-success"></i>
    <p class="fw-bold mb-0">{{msg}}</p>
</div>
{{/if}}
{{#if error}}
<div id="errordiv" class="d-flex gap-3 alert alert-danger alert-dismissible fade show position-fixed top-0 end-0 me-5 m-3">
    <i class="bi bi-x-square-fill text-danger"></i>
    <p class="fw-bold mb-0">{{error}}</p>
</div>
{{/if}}
<div class="page-shell">
    <div class="form-card">
        <div class="card-body">
            <h1 class="form-title">Cadastro de Sob Medida</h1>
            <p class="form-subtitle">Registre as medidas específicas para o cliente com o mesmo padrão visual das telas de pedido.</p>

            <form id="form" class="row g-3">
                <div class="col-12 col-md-6">
                    <label for="inputBusto" class="form-label">Busto</label>
                    <input class="form-control" id="inputBusto" name="busto">
                </div>

                <div class="col-12 col-md-6">
                    <label for="inputCintura" class="form-label">Cintura</label>
                    <input class="form-control" id="inputCintura" name="cintura">
                </div>

                <div class="col-12 col-md-6">
                    <label for="inputQuadril" class="form-label">Quadril</label>
                    <input class="form-control" id="inputQuadril" name="quadril">
                </div>

                <div class="col-12 col-md-6">
                    <label for="inputComprimento" class="form-label">Comprimento</label>
                    <input class="form-control" id="inputComprimento" name="comprimento">
                </div>

                <div class="col-12 col-md-6">
                    <label for="inputOmbro" class="form-label">Ombro</label>
                    <input class="form-control" id="inputOmbro" name="ombro">
                </div>

                <div class="col-12 col-md-6">
                    <label for="inputCostas" class="form-label">Costas</label>
                    <input class="form-control" id="inputCostas" name="costas">
                </div>

                <div class="col-12 col-md-6">
                    <label for="inputCManga" class="form-label">Comprimento da Manga</label>
                    <input class="form-control" id="inputCManga" name="comprimento_da_manga">
                </div>

                <div class="col-12 col-md-6">
                    <label for="inputLManga" class="form-label">Largura da Manga</label>
                    <input class="form-control" id="inputLManga" name="largura_da_manga">
                </div>

                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-primary">Enviar</button>
                </div>
            </form>
        </div>
    </div>
</div>    
